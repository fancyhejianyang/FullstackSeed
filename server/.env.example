PORT=4000

# 运行环境：development | production | test
# 非 production 时 TypeORM synchronize 自动开启（自动同步表结构）
NODE_ENV=development

# 跨域来源，多个来源用逗号分隔；开发默认 *，生产建议显式配置域名
CORS_ORIGIN=*

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=""
DB_NAME=fullstack_seed

# JWT 配置
JWT_SECRET=fullstack_seed_secret
JWT_EXPIRES_IN=7d

# 加密配置（bcrypt 加密强度）
BCRYPT_SALT_ROUNDS=10

# 上传文件公开访问域名；留空则接口返回 /uploads/... 相对地址
# 未来切换 OSS/CDN 时可配置为 https://cdn.example.com
UPLOAD_PUBLIC_BASE_URL=

# 本地 OCR 配置；TESSERACT_WARMUP_ON_START=true 时服务启动后异步预热 Worker
TESSERACT_LANGS=chi_sim
TESSERACT_LANG_PATH=
TESSERACT_CACHE_PATH=
TESSERACT_INIT_TIMEOUT_MS=30000
TESSERACT_RECOGNIZE_TIMEOUT_MS=60000
TESSERACT_ALLOW_REMOTE_LANG_DOWNLOAD=false
TESSERACT_WARMUP_ON_START=false

# 向量数据库配置；Chroma 服务需单独部署或本地启动
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=knowledge_chunks
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_TOKEN=

# 首次启动自动创建 root 管理员时使用；生产环境必须显式配置
ADMIN_PASSWORD=root123
